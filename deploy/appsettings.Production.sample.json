{
  "ConnectionStrings": {
    "SignageDb": "Data Source=../data/signage.db;Mode=ReadWriteCreate;Pooling=True;Default Timeout=5;Foreign Keys=True"
  },
  "Database": {
    "EnableWal": true,
    "BusyTimeoutSeconds": 5,
    "InstanceLockPath": "../data/signage.lock"
  },
  "Storage": {
    "RootPath": "../data/content",
    "RetainedVersionsPerPresentation": 5,
    "MinimumFreeBytes": 536870912,
    "CleanupDryRun": false,
    "CleanupIntervalMinutes": 360,
    "TemporaryFileMaximumAgeHours": 24
  },
  "Rendering": {
    "NodeExecutable": "node",
    "ConverterEntryPoint": "../converter/dist/cli.js",
    "WorkingDirectory": "../converter",
    "TempRoot": "../data/temp",
    "FontDirectories": ["../fonts"],
    "UseSystemFonts": false,
    "FitTextToBox": true,
    "FontMapping": {
      "Calibri": "Carlito",
      "Aptos": "Carlito",
      "Aptos Display": "Carlito",
      "Arial": "Arimo",
      "Times New Roman": "Tinos",
      "Courier New": "Cousine",
      "Cambria": "Caladea"
    },
    "OutputWidth": 1920,
    "TimeoutSeconds": 300,
    "MaximumAttempts": 3,
    "Concurrency": 1,
    "MaximumCapturedOutputBytes": 1048576
  },
  "Media": {
    "EnableYouTube": true,
    "MaximumEmbeddedVideoBytes": 262144000,
    "StartupTimeoutSeconds": 20,
    "StallTimeoutSeconds": 30,
    "MaximumPlaybackSeconds": 3600
  },
  "Backup": {
    "RootPath": "../backups"
  },
  "Authentication": {
    "Mode": "OpenIdConnect",
    "Authority": "https://identity.example.edu/",
    "ClientId": "school-signage",
    "ClientSecret": "SET_WITH_Authentication__ClientSecret_ENVIRONMENT_VARIABLE",
    "TeacherRoleClaim": "Teacher",
    "AdminRoleClaim": "SignageAdmin",
    "SessionMinutes": 480
  },
  "ActiveDirectory": {
    "Host": "",
    "Port": 636,
    "DomainName": "",
    "UpnSuffix": "",
    "NetBiosDomain": "",
    "BaseDn": "",
    "BootstrapAdminUpn": "",
    "TimeoutSeconds": 10
  },
  "AllowedHosts": "signage.example.edu"
}
