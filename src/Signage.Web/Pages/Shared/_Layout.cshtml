@inject Microsoft.Extensions.Options.IOptions<Signage.Application.AuthenticationOptions> Authentication
@{
    var currentPage = ViewContext.RouteData.Values["page"] as string ?? string.Empty;
    string? Current(params string[] pages) => pages.Contains(currentPage, StringComparer.OrdinalIgnoreCase) ? "page" : null;
    var signedIn = User.Identity?.IsAuthenticated == true;
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · School Signage</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script src="~/js/prefs.js" asp-append-version="true"></script>
</head>
<body class="teacher">
    <header class="topbar">
        <a class="brand" asp-page="/Index">
            <span class="brand-mark">@Icons.Get("monitor")</span>
            <span>School Signage</span>
        </a>
        @if (signedIn)
        {
            @if (User.IsInRole("Teacher") || User.IsInRole("SignageAdmin"))
            {
            <nav class="topnav" aria-label="Primary">
                <a class="nav-link" asp-page="/Publish" aria-current="@Current("/Publish")">@Icons.Get("upload")<span>Publish</span></a>
                <a class="nav-link" asp-page="/History" aria-current="@Current("/History", "/Status", "/Preview")">@Icons.Get("slides")<span>My presentations</span></a>
            </nav>
            }
            <partial name="_AccountMenu" />
        }
    </header>
    @if (Authentication.Value.Mode.Equals("Development", StringComparison.OrdinalIgnoreCase))
    {
        <div class="dev-banner" role="status">Development sign-in</div>
    }
    <main class="main">
        <div class="page">@RenderBody()</div>
    </main>
    <script src="~/js/site.js" asp-append-version="true" defer></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
