@page
@inject Signage.Web.Services.SlidePosters Posters
@model Signage.Web.Pages.Admin.DevicesModel
@{
    Layout = "_AdminLayout"; ViewData["Title"] = "Devices";
    var now = Model.Now;
    var states = Model.Devices.Select(Model.StateOf).ToList();
}
<header class="page-head">
    <h1>Devices</h1>
    <div class="page-actions"><a class="btn btn-primary" asp-page="/Admin/Pairing">@Icons.Get("plus")Pair a device</a></div>
</header>
@if (TempData["Message"] is string message) { <div class="flash" role="status">@Icons.Get("check")@message</div> }

@if (Model.Devices.Count == 0)
{
    <div class="card empty">
        @Icons.Get("monitor")
        <strong>No devices have been paired</strong>
        <a class="btn btn-primary" asp-page="/Admin/Pairing">Pair a device</a>
    </div>
}
else
{
    <div class="toolbar" data-filter-controls="#device-list" data-filter-empty="#device-empty">
        <label class="search">@Icons.Get("search")<span class="visually-hidden">Search devices</span><input type="search" placeholder="Search devices" data-filter-search /></label>
        <div class="segmented" role="group" aria-label="Filter by state">
            <button type="button" data-filter-state="all" aria-pressed="true">All <span class="count">@states.Count</span></button>
            <button type="button" data-filter-state="online" aria-pressed="false">Online <span class="count">@states.Count(state => state == "online")</span></button>
            <button type="button" data-filter-state="offline" aria-pressed="false">Offline <span class="count">@states.Count(state => state == "offline")</span></button>
            <button type="button" data-filter-state="revoked" aria-pressed="false">Revoked <span class="count">@states.Count(state => state == "revoked")</span></button>
        </div>
    </div>
    <div class="card flush">
        <div class="table-wrap">
            <table class="data">
                <thead><tr><th>Device</th><th>Status</th><th>Screen group</th><th>Playing</th><th class="actions"><span class="visually-hidden">Actions</span></th></tr></thead>
                <tbody id="device-list">
                @foreach (var device in Model.Devices)
                {
                    var state = Model.StateOf(device);
                    var playing = device.PlayingPresentationVersionId is Guid playingId && Model.PlayingVersions.TryGetValue(playingId, out var version) ? version : null;
                    var poster = state == "revoked" ? null : Posters.GetUrl(playing);
                    <tr data-filter-item data-state="@state">
                        <td>
                            <div class="device-cell">
                                <span class="screen @(state == "online" ? "" : "is-off")">
                                    <span class="screen-glass">@if (poster is not null) { <img src="@poster" alt="" loading="lazy" /> }</span>
                                    <span class="dot @(state == "online" ? "dot-good" : state == "offline" ? "dot-warn" : "")"></span>
                                </span>
                                <span>
                                    <span class="cell-title">@device.Name</span>
                                    <span class="cell-sub" title="@device.BrowserSummary">@Display.Browser(device.BrowserSummary)</span>
                                    @if (!string.IsNullOrWhiteSpace(device.LastIpAddress)) { <span class="cell-sub mono">@device.LastIpAddress</span> }
                                </span>
                            </div>
                        </td>
                        <td>
                            @if (state == "revoked")
                            {
                                <span class="pill">Revoked</span>
                                <span class="cell-sub">@Display.Ago(device.RevokedUtc, now)</span>
                            }
                            else
                            {
                                <span class="pill @(state == "online" ? "pill-good" : "pill-warn")">@(state == "online" ? "Online" : "Offline")</span>
                                <span class="cell-sub nowrap" title="@(device.LastSeenUtc is null ? "" : Display.DateTime(device.LastSeenUtc.Value))">@(device.LastSeenUtc is null ? "Never seen" : $"Seen {Display.Ago(device.LastSeenUtc, now)}")</span>
                            }
                        </td>
                        <td>
                            <form method="post" asp-page-handler="Move" class="inline-form">
                                <input type="hidden" name="deviceId" value="@device.Id" />
                                <select name="screenGroupId" aria-label="Move @device.Name">
                                    <option value="">Unassigned</option>
                                    @foreach (var group in Model.Groups) { <option value="@group.Id" selected="@(group.Id == device.ScreenGroupId)">@group.Name</option> }
                                </select>
                                <button class="btn btn-secondary btn-sm" type="submit">Move</button>
                            </form>
                        </td>
                        <td>
                            @if (playing is not null)
                            {
                                <span class="cell-title">@playing.Presentation.Name</span>
                                <span class="cell-sub">Version @playing.VersionNumber</span>
                            }
                            else
                            {
                                <span class="muted">@(device.PlayingContentId is null ? "Nothing reported" : "Unknown content")</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(device.LastError))
                            {
                                <span class="device-error">@Icons.Get("alert")<span>@device.LastError</span></span>
                            }
                        </td>
                        <td class="actions">
                            @if (device.RevokedUtc is null)
                            {
                                <form method="post" asp-page-handler="Revoke"><input type="hidden" name="deviceId" value="@device.Id" /><button class="btn btn-danger btn-sm" type="submit">Revoke</button></form>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        <p class="filter-empty" id="device-empty" hidden>No devices match.</p>
    </div>
}
