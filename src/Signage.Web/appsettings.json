{
  "ConnectionStrings": {
    "SignageDb": "Data Source=../../.local-data/signage.db;Mode=ReadWriteCreate;Pooling=True;Default Timeout=5;Foreign Keys=True"
  },
  "Database": {
    "EnableWal": true,
    "BusyTimeoutSeconds": 5,
    "InstanceLockPath": "../../.local-data/signage.lock"
  },
  "Signage": {
    "SiteName": "School Signage",
    "TimeZone": "Europe/London",
    "DefaultSlideDurationSeconds": 10,
    "MinimumSlideDurationSeconds": 2,
    "MaximumSlideDurationSeconds": 120,
    "PlayerPollSeconds": 60,
    "HeartbeatSeconds": 60,
    "OfflineAfterSeconds": 180
  },
  "Uploads": {
    "MaximumBytes": 262144000,
    "MaximumSlides": 300,
    "MaximumZipEntries": 10000,
    "MaximumUncompressedBytes": 1073741824,
    "MaximumCompressionRatio": 200
  },
  "Rendering": {
    "NodeExecutable": "node",
    "ConverterEntryPoint": "../Signage.Converter/dist/cli.js",
    "WorkingDirectory": "../Signage.Converter",
    "TempRoot": "../../.local-data/temp",
    "FontDirectories": ["../../fonts"],
    "UseSystemFonts": false,
    "FitTextToBox": true,
    "FontMapping": {
      "Calibri": "Carlito",
      "Aptos": "Carlito",
      "Aptos Display": "Carlito",
      "Arial": "Arimo",
      "Times New Roman": "Tinos",
      "Courier New": "Cousine",
      "Cambria": "Caladea"
    },
    "OutputWidth": 1920,
    "TimeoutSeconds": 300,
    "MaximumAttempts": 3,
    "Concurrency": 1,
    "MaximumCapturedOutputBytes": 1048576
  },
  "Media": {
    "EnableYouTube": true,
    "MaximumEmbeddedVideoBytes": 262144000,
    "StartupTimeoutSeconds": 20,
    "StallTimeoutSeconds": 30,
    "MaximumPlaybackSeconds": 3600
  },
  "Storage": {
    "RootPath": "../../.local-data/content",
    "RetainedVersionsPerPresentation": 5,
    "MinimumFreeBytes": 536870912,
    "CleanupDryRun": false,
    "CleanupIntervalMinutes": 360,
    "TemporaryFileMaximumAgeHours": 24
  },
  "Backup": {
    "RootPath": "../../backups"
  },
  "Authentication": {
    "Mode": "OpenIdConnect",
    "Authority": "",
    "ClientId": "",
    "ClientSecret": "",
    "TeacherRoleClaim": "Teacher",
    "AdminRoleClaim": "SignageAdmin",
    "SessionMinutes": 480
  },
  "ActiveDirectory": {
    "Host": "",
    "Port": 636,
    "DomainName": "",
    "UpnSuffix": "",
    "NetBiosDomain": "",
    "BaseDn": "",
    "BootstrapAdminUpn": "",
    "TimeoutSeconds": 10
  },
  "Logging": {
    "Console": { "FormatterName": "json" },
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*"
}
